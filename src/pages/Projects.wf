page Projects(path: "/projects", title: "Projects — Monzer Omer",
              description: "Things I've designed, built, and shipped: WebFluent, Circles, Al-Hakeem, Dabdoob and open-source Rust tools.") {
    derived featured = projects.filter(p => p.featured)
    derived rest = projects.filter(p => !p.featured)

    Stack(class: "page") {
        PageHead("Projects", eyebrow: "Work", lead: "Things I've designed, built, and shipped.")
        Stack {
            style { gap: 24px }
            for p in featured by p.id {
                ProjectCard(p)
            }
            Grid(columns: { base: 1, md: 2 }, gap: .md) {
                style { gap: 16px; @md { gap: 24px } }
                for p in rest by p.id {
                    ProjectCard(p)
                }
            }
        }
    }
}
