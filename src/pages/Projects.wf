                                padding: "0.25rem 0.75rem"
                                border-radius: "0.375rem"
                                font-size: "0.75rem"
                            }
                        }
                        Badge("ARM") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                background: "#2D2C2A"
                                color: "#E8E6E1"
                                padding: "0.25rem 0.75rem"
                                border-radius: "0.375rem"
                                font-size: "0.75rem"
                            }
                        }
                        Badge("Open Source") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                background: "#2D2C2A"
                                color: "#E8E6E1"
                                padding: "0.25rem 0.75rem"
                                border-radius: "0.375rem"
                                font-size: "0.75rem"
                            }
                        }
                    }
                }
            }

            Card(elevated) {
                style {
                    background: "#242422"
                    border: "1px solid #C69C6D"
                    border-radius: "0.75rem"
                    padding: "2rem"
                    margin-bottom: "2rem"
                }

                Stack(gap: md) {
                    Row(justify: between, align: center) {
                        Link(to: "https://github.com/monzeromer-lab/micro-kernel-backend") {
                            Text("Micro-kernel Architecture", bold) {
                                style {
                                    font-size: "1.2rem"
                                    color: "#E8E6E1"
                                }
                            }
                        }
                        Badge("Tech Talk", primary) {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                background: "#C69C6D"
                                color: "#1A1A19"
                                padding: "0.25rem 0.75rem"
                                border-radius: "0.375rem"
                                font-size: "0.75rem"
                                font-weight: "600"
                            }
                        }
                    }

                    Text("A micro-kernel web backend where business logic lives in dynamically-loaded WebAssembly modules.", muted) {
                        style {
                            color: "#8C8B88"
                            font-size: "0.95rem"
                        }
                    }

                    Spacer(sm)

                    Text("The server core is intentionally minimal — routing, auth, and module lifecycle. All business logic runs in sandboxed WebAssembly modules that can be deployed, hot-swapped, rolled back, call external services, and call each other via an internal IPC layer. A demo of how micro-kernel principles apply to backend architecture.") {
                        style {
                            color: "#E8E6E1"
                            line-height: "1.7"
                            font-size: "0.95rem"
                        }
                    }

                    Spacer(sm)

                    Row(gap: sm) {
                        Badge("Rust") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                background: "#C69C6D"
                                color: "#1A1A19"
                                padding: "0.25rem 0.75rem"
                                border-radius: "0.375rem"
                                font-size: "0.75rem"
                                font-weight: "600"
                            }
                        }
                        Badge("WebAssembly") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                background: "#2D2C2A"
                                color: "#E8E6E1"
                                padding: "0.25rem 0.75rem"
                                border-radius: "0.375rem"
                                font-size: "0.75rem"
                            }
                        }
                        Badge("Systems Design") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                background: "#2D2C2A"
                                color: "#E8E6E1"
                                padding: "0.25rem 0.75rem"
                                border-radius: "0.375rem"
                                font-size: "0.75rem"
                            }
                        }
                        Badge("Architecture") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                background: "#2D2C2A"
                                color: "#E8E6E1"
                                padding: "0.25rem 0.75rem"
                                border-radius: "0.375rem"
                                font-size: "0.75rem"
                            }
                        }
                    }
                }
            }
        }
    }
}
