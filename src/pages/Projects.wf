Page Projects (path: "/projects", title: "Projects — Monzer Omer") {

    Container {
        style {
            max-width: "800px"
            margin: "0 auto"
            padding: "80px 2rem"

            @media (max-width: 768px) {
                padding: "60px 1.5rem"
            }
            @media (max-width: 480px) {
                padding: "40px 1rem"
            }
        }

        Stack(gap: md) {
            Heading("Projects", h1, fadeIn) {
                style {
                    font-size: "2rem"
                    font-weight: "700"
                    color: "#E8E6E1"
                    letter-spacing: "-0.02em"
                    margin-bottom: "1rem"
                }
            }

            Text("Things I've designed, built, and shipped.", muted, fadeIn) {
                style {
                    color: "#8C8B88"
                    font-size: "1rem"
                    margin-bottom: "3rem"
                }
            }

            Spacer(xl)

            Card(elevated) {
                style {
                    background: "#242422"
                    border: "1px solid #C69C6D"
                    border-radius: "0.75rem"
                    padding: "2rem"
                    margin-bottom: "2rem"
                }

                Stack(gap: md) {
                    Row(justify: between, align: center) {
                        Link(to: "https://github.com/monzeromer-lab/WebFluent") {
                            Text("WebFluent", bold) {
                                style {
                                    font-size: "1.2rem"
                                    color: "#E8E6E1"
                                }
                            }
                        }
                        Badge("Flagship", primary) {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                background: "#C69C6D"
                                color: "#1A1A19"
                                padding: "0.25rem 0.75rem"
                                border-radius: "0.375rem"
                                font-size: "0.75rem"
                                font-weight: "600"
                            }
                        }
                    }

                    Text("A web-first programming language that compiles to HTML, CSS, JavaScript, and PDF.", muted) {
                        style {
                            color: "#8C8B88"
                            font-size: "0.95rem"
                        }
                    }

                    Spacer(sm)

                    Text("WebFluent replaces the traditional web stack with a single, expressive language. It features reactive state, declarative UI components, built-in routing, i18n, SSG, and PDF output — all from .wf source files. This portfolio is built entirely with WebFluent.") {
                        style {
                            color: "#E8E6E1"
                            line-height: "1.7"
                            font-size: "0.95rem"
                        }
                    }

                    Spacer(sm)

                    Stack(gap: md) {
                        Text("Key features:", bold) {
                            style {
                                color: "#C69C6D"
                                font-size: "0.9rem"
                                font-weight: "600"
                            }
                        }
                        Text("Reactive state & computed values with automatic UI updates") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.85rem"
                            }
