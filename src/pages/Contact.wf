page Contact(path: "/contact", title: "Contact — Monzer Omer",
             description: "Available for senior backend roles, architecture consulting, and high-impact engineering challenges.") {
    Stack(class: "page") {
        PageHead("Let's build something robust", eyebrow: "Contact", lead: "Available for senior backend roles, architecture consulting, and high-impact engineering challenges.")
        Stack(class: "panel") {
            style { max-width: 680px; gap: 20px }
            Stack(class: "rows") {
                Row(class: "row-item") {
                    Text("Email", class: "label")
                    Link(EMAIL, href: "mailto:{EMAIL}")
                }
                Row(class: "row-item") {
                    Text("LinkedIn", class: "label")
                    Link("linkedin.com/in/monzeromer", href: LINKEDIN, data-track: "generate_lead", data-track-method: "linkedin")
                }
                Row(class: "row-item") {
                    Text("GitHub", class: "label")
                    Link("github.com/monzeromer-lab", href: GITHUB, data-track: "generate_lead", data-track-method: "github")
                }
            }
            Row {
                Link("Write an email", href: "mailto:{EMAIL}", class: "btn btn-primary")
            }
        }
        Stack(class: "callout") {
            style { max-width: 680px; margin-top: 24px }
            Text("Working with me", class: "callout-title")
            Text("I move fast. {AI_SHARE}% of my coding workflow is AI-assisted, which means I prototype quickly, iterate in hours not days, and deliver production-quality code without the usual overhead. If you value speed and quality together, we'll work well.", class: "body")
        }
    }
}
