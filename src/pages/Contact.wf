/// How to reach me, and what working with me is like.
component ContactView(lang: Lang = .ar) {
    derived c = if lang == .ar { copyAr } else { copyEn }

    Stack(class: "page") {
        PageHead(c.contact_h, lead: c.contact_lead)
        Row(class: "contact") {
            Stack(class: "contact-main") {
                Link(EMAIL, href: "mailto:{EMAIL}", class: "contact-email", dir: "ltr")
                Row {
                    Link(c.write, href: "mailto:{EMAIL}", class: "btn btn-primary")
                }
            }
            Stack(class: "channels") {
                Row(class: "channel") {
                    Text(c.email_l, class: "label")
                    Link(EMAIL, href: "mailto:{EMAIL}", dir: "ltr")
                }
                Row(class: "channel") {
                    Text("LinkedIn", class: "label")
                    Link("linkedin.com/in/monzeromer", href: LINKEDIN, dir: "ltr", data-track: "generate_lead", data-track-method: "linkedin")
                }
                Row(class: "channel") {
                    Text("GitHub", class: "label")
                    Link("github.com/monzeromer-lab", href: GITHUB, dir: "ltr", data-track: "generate_lead", data-track-method: "github")
                }
            }
        }
        Row(class: "section split working") {
            Stack(class: "split-head") {
                Heading(c.with_h, class: "section-title").h2
            }
            Stack(class: "split-body") {
                Text(c.with_p, class: "body muted")
            }
        }
    }
}

page ContactAr(path: "/contact", title: "تواصل — منذر عمر",
               description: "متاح لأدوار Senior Backend، واستشارات Architecture، والتحديات الهندسية عالية الأثر.",
               layout: Shell(lang: .ar, current: .contact)) {
    head {
        link(rel: "alternate", hreflang: "ar", href: "{SITE}/contact")
        link(rel: "alternate", hreflang: "en", href: "{SITE}/en/contact")
        link(rel: "alternate", hreflang: "x-default", href: "{SITE}/contact")
    }
    ContactView(lang: .ar)
}

page ContactEn(path: "/en/contact", title: "Contact — Monzer Omer",
               description: "Available for senior backend roles, architecture consulting, and high-impact engineering challenges.",
               layout: Shell(lang: .en, current: .contact)) {
    head {
        link(rel: "alternate", hreflang: "ar", href: "{SITE}/contact")
        link(rel: "alternate", hreflang: "en", href: "{SITE}/en/contact")
        link(rel: "alternate", hreflang: "x-default", href: "{SITE}/contact")
    }
    ContactView(lang: .en)
}
