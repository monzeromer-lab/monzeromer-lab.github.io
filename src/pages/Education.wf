page Education(path: "/education", title: "Education — Monzer Omer",
               description: "Bachelor of Information Technology, National Ribat University, and certifications in backend engineering.") {
    Stack(class: "page") {
        PageHead("Education", eyebrow: "Study")
        Stack(class: "timeline") {
            for d in education.degrees by d.school {
                Stack(class: "entry") {
                    Stack(class: "entry-when") {
                        Text("{d.from} — {d.to}", class: "meta")
                    }
                    Stack {
                        style { gap: 12px; min-width: 0 }
                        Stack {
                            style { gap: 2px }
                            Heading(d.school, class: "card-title").h2
                            Text(d.degree, class: "body-muted")
                        }
                        Text(d.body, class: "body")
                        Points(d.points)
                        Row(align: .center, gap: .sm) {
                            Text("Activities", class: "label")
                            Chips(d.activities)
                        }
                    }
                }
            }
        }

        Stack {
            style { gap: 24px; margin-top: 32px }
            Heading("Certifications", class: "section-title").h2
            Grid(columns: { base: 1, md: 2 }, gap: .md) {
                style { gap: 16px; @md { gap: 24px } }
                for c in education.certifications by c.name {
                    Stack(class: "panel") {
                        style { gap: 10px }
                        Text("{c.issuer} · {c.date}", class: "meta")
                        Heading(c.name, class: "card-title").h3
                        if c.body != "" {
                            Text(c.body, class: "body-muted")
                        }
                        if c.topics.length > 0 {
                            Chips(c.topics)
                        }
                    }
                }
            }
        }
    }
}
