Page Education (path: "/education", title: "Education — Monzer Omer") {

    Container {
        style {
            max-width: "800px"
            margin: "0 auto"
            padding: "80px 2rem"

            @media (max-width: 768px) {
                padding: "60px 1.5rem"
            }
            @media (max-width: 480px) {
                padding: "40px 1rem"
            }
        }

        Stack(gap: md) {
            Heading("Education", h1, fadeIn) {
                style {
                    font-size: "2rem"
                    font-weight: "700"
                    color: "#E8E6E1"
                    letter-spacing: "-0.02em"
                    margin-bottom: "3rem"
                }
            }

            Card(elevated) {
                style {
                    background: "#242422"
                    border: "1px solid #2D2C2A"
                    border-radius: "0.75rem"
                    padding: "2rem"
                    margin-bottom: "2rem"
                }

                Stack(gap: md) {
                    Text("National Ribat University", bold) {
                        style {
                            font-size: "1.2rem"
                            color: "#E8E6E1"
                        }
                    }

                    Text("Bachelor of Information Technology", muted) {
                        style {
                            color: "#8C8B88"
                            font-size: "0.95rem"
                        }
                    }

                    Text("Oct 2018 — Feb 2025") {
                        style {
                            color: "#C69C6D"
                            font-family: "JetBrains Mono, monospace"
                            font-size: "0.85rem"
                        }
                    }

                    Spacer(sm)

                    Text("Completed a comprehensive IT degree over nearly 7 years, overcoming challenges such as COVID-19, political unrest, and revolution. Gained expertise in programming fundamentals, data structures, software engineering, database management, system analysis, and network technologies.") {
                        style {
                            color: "#E8E6E1"
                            line-height: "1.7"
                            font-size: "0.95rem"
                        }
                    }

                    Spacer(sm)

                    Stack(gap: md) {
                        Text("Highlights:", bold) {
                            style {
                                color: "#C69C6D"
                                font-size: "0.9rem"
                                font-weight: "600"
                            }
                        }
                        Text("Developed practical skills through semester-long projects starting from Semester 3, applying theoretical knowledge to real-world IT solutions") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.85rem"
                            }
                        }
                        Text("Enhanced soft skills through courses in communication, research methodology, and professional ethics") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.85rem"
                            }
                        }
                        Text("Balanced academics with work experience, gaining hands-on industry insights and strengthening adaptability and time management") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.85rem"
                            }
                        }
                        Text("Built a strong foundation in IT, combining technical expertise with problem-solving and teamwork skills") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.85rem"
                            }
                        }
                        Text("Activities: GDSC, Open Days, Juniors Welcoming") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#8C8B88"
                                font-size: "0.8rem"
                            }
                        }
                    }
                }
            }

            Heading("Certifications", h2, fadeIn) {
                style {
                    font-size: "1.5rem"
                    font-weight: "700"
                    color: "#E8E6E1"
                    letter-spacing: "-0.02em"
                    margin-bottom: "1rem"
                    margin-top: "1rem"
                }
            }

            Card(elevated) {
                style {
                    background: "#242422"
                    border: "1px solid #2D2C2A"
                    border-radius: "0.75rem"
                    padding: "2rem"
                    margin-bottom: "2rem"
                }

                Stack(gap: md) {
                    Text("Fundamentals of Backend Engineering", bold) {
                        style {
                            font-size: "1rem"
                            color: "#E8E6E1"
                        }
                    }
                    Text("Udemy — Aug 2025", muted) {
                        style {
                            color: "#C69C6D"
                            font-family: "JetBrains Mono, monospace"
                            font-size: "0.8rem"
                        }
                    }
                    Text("Deep dive into the protocols and communication patterns that power modern backend systems.") {
                        style {
                            color: "#8C8B88"
                            font-size: "0.9rem"
                            line-height: "1.6"
                        }
                    }
                }
            }

            Card(elevated) {
                style {
                    background: "#242422"
                    border: "1px solid #2D2C2A"
                    border-radius: "0.75rem"
                    padding: "2rem"
                    margin-bottom: "2rem"
                }

                Stack(gap: md) {
                    Row(gap: sm) {
                        Badge("Coursera") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                background: "#2D2C2A"
                                color: "#E8E6E1"
                                padding: "0.2rem 0.6rem"
                                border-radius: "0.375rem"
                                font-size: "0.7rem"
                            }
                        }
                        Badge("2020") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                background: "#2D2C2A"
                                color: "#8C8B88"
                                padding: "0.2rem 0.6rem"
                                border-radius: "0.375rem"
                                font-size: "0.7rem"
                            }
                        }
                    }
                    Text("Server-side Development with NodeJS, Express and MongoDB") {
                        style {
                            font-family: "JetBrains Mono, monospace"
                            color: "#E8E6E1"
                            font-size: "0.9rem"
                        }
                    }
                    Text("Introduction to HTML5 · Interactivity with JavaScript · Front-End Web UI Frameworks: Bootstrap 4 · IT Project Management · Front-End Web Development with React · Introduction to TCP/IP · Introduction to CSS3 · Computer Security and Systems Management") {
                        style {
                            color: "#8C8B88"
                            font-size: "0.85rem"
                            line-height: "1.6"
                        }
                    }
                }
            }
        }
    }
}
