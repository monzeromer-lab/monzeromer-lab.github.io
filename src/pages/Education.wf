/// The degree, then every certification as a table.
component EducationView(lang: Lang = .ar) {
    derived c = if lang == .ar { copyAr } else { copyEn }
    derived edu = if lang == .ar { educationAr } else { education }

    Stack(class: "page") {
        PageHead(c.edu_h)
        Stack(class: "entries") {
            for d in edu.degrees by d.school {
                Row(class: "entry") {
                    Stack(class: "entry-when") {
                        Text("{d.from} – {d.to}", class: "num")
                        if d.length != "" {
                            Text(d.length, class: "num subtle")
                        }
                    }
                    Stack(class: "entry-what") {
                        Stack(class: "entry-title") {
                            Heading(d.school, class: "entry-name").h2
                            Text(d.degree, class: "entry-sub")
                        }
                        Text(d.body, class: "body")
                        Points(d.points)
                        Row(class: "activities") {
                            Text(c.activities, class: "label")
                            Chips(d.activities)
                        }
                    }
                }
            }
        }
        Stack(class: "section certs") {
            Heading(c.certs_h, class: "section-title").h2
            Stack(class: "table-scroll") {
                Table(caption: c.certs_h, class: "cert-table") {
                    Table.Head {
                        Table.Row {
                            Table.Cell(c.cert_course)
                            Table.Cell(c.cert_issuer)
                            Table.Cell(c.cert_date)
                        }
                    }
                    Table.Body {
                        for cert in edu.certifications by cert.name {
                            Table.Row {
                                Table.Cell {
                                    Text(cert.name, class: "cert-name", dir: "ltr")
                                    if cert.body != "" {
                                        Text(cert.body, class: "cert-body")
                                    }
                                }
                                Table.Cell(cert.issuer)
                                Table.Cell(cert.date, class: "num")
                            }
                        }
                    }
                }
            }
        }
    }
}

page EducationAr(path: "/education", title: "التعليم — منذر عمر",
                 description: "بكالوريوس تقنية المعلومات من جامعة الرباط الوطني، وشهادات في الـ Backend Engineering.",
                 layout: Shell(lang: .ar, current: .education)) {
    head {
        link(rel: "alternate", hreflang: "ar", href: "{SITE}/education")
        link(rel: "alternate", hreflang: "en", href: "{SITE}/en/education")
        link(rel: "alternate", hreflang: "x-default", href: "{SITE}/education")
    }
    EducationView(lang: .ar)
}

page EducationEn(path: "/en/education", title: "Education — Monzer Omer",
                 description: "Bachelor of Information Technology, National Ribat University, and certifications in backend engineering.",
                 layout: Shell(lang: .en, current: .education)) {
    head {
        link(rel: "alternate", hreflang: "ar", href: "{SITE}/education")
        link(rel: "alternate", hreflang: "en", href: "{SITE}/en/education")
        link(rel: "alternate", hreflang: "x-default", href: "{SITE}/education")
    }
    EducationView(lang: .en)
}
