Page Skills (path: "/skills", title: "Skills — Monzer Omer") {

    Container {
        style {
            max-width: "800px"
            margin: "0 auto"
            padding: "80px 2rem"

            @media (max-width: 768px) {
                padding: "60px 1.5rem"
            }
            @media (max-width: 480px) {
                padding: "40px 1rem"
            }
        }

        Stack(gap: md) {
            Heading("Infrastructure & Capabilities", h1, fadeIn) {
                style {
                    font-size: "2rem"
                    font-weight: "700"
                    color: "#E8E6E1"
                    letter-spacing: "-0.02em"
                    margin-bottom: "1rem"
                }
            }

            Text("Languages, frameworks, and systems I architect, build, and deploy with.", muted) {
                style {
                    color: "#8C8B88"
                    font-size: "1rem"
                    margin-bottom: "3rem"
                }
            }

            Spacer(xl)

            Grid(columns: 2, gap: md) {

                Card(elevated) {
                    style {
                        background: "#242422"
                        border: "1px solid #2D2C2A"
                        border-radius: "0.75rem"
                        padding: "2rem"
                    }

                    Stack(gap: md) {
                        Text("Languages", bold) {
                            style {
                                font-size: "1rem"
                                color: "#C69C6D"
                                font-weight: "600"
                                margin-bottom: "0.5rem"
                            }
                        }
                        Text("Rust") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.9rem"
                            }
                        }
                        Text("TypeScript") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.9rem"
                            }
                        }
                        Text("JavaScript") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.9rem"
                            }
                        }
                        Text("SQL") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.9rem"
                            }
                        }
                    }
                }

                Card(elevated) {
                    style {
                        background: "#242422"
                        border: "1px solid #2D2C2A"
                        border-radius: "0.75rem"
                        padding: "2rem"
                    }

                    Stack(gap: md) {
                        Text("Databases & Storage", bold) {
                            style {
                                font-size: "1rem"
                                color: "#C69C6D"
                                font-weight: "600"
                                margin-bottom: "0.5rem"
                            }
                        }
                        Text("PostgreSQL") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.9rem"
                            }
                        }
                        Text("MySQL") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.9rem"
                            }
                        }
                        Text("MongoDB") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.9rem"
                            }
                        }
                        Text("Firebase") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
