                        }
                        Text("React Native") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.9rem"
                            }
                        }
                        Text("Electron") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.9rem"
                            }
                        }
                        Text("Tauri") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.9rem"
