page Skills(path: "/skills", title: "Skills — Monzer Omer",
            description: "Languages, frameworks, and systems I architect, build, and deploy with.") {
    Stack(class: "page") {
        PageHead("Infrastructure and capabilities", eyebrow: "Skills", lead: "Languages, frameworks, and systems I architect, build, and deploy with.")
        AICallout
        Spacer { style { height: 32px } }
        Grid(columns: { base: 1, md: 2, lg: 4 }, gap: .md) {
            style { gap: 16px; @md { gap: 24px } }
            for g in skills by g.group {
                Stack(class: "panel") {
                    style { gap: 14px }
                    Heading(g.group, class: "card-title").h2
                    Chips(g.items)
                }
            }
        }
    }
}
