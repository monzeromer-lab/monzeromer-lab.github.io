                        }
                        Text("Microservices Architecture") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.9rem"
                            }
                        }
                        Text("Distributed Systems") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.9rem"
                            }
                        }
                        Text("WebAssembly") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.9rem"
                            }
                        }
                        Text("System Design") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.9rem"
                            }
                        }
                        Text("Compiler Design") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.9rem"
                            }
