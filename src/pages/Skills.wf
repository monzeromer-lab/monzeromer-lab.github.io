                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.9rem"
                            }
                        }
                        Text("RabbitMQ") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
                                font-size: "0.9rem"
                            }
                        }
                        Text("Event-Driven Design") {
                            style {
                                font-family: "JetBrains Mono, monospace"
                                color: "#E8E6E1"
