page Experience(path: "/experience", title: "Experience — Monzer Omer",
                description: "Backend roles since 2020, newest first: SilverKey Technologies, Ecom Payments, Circles, Alimny and EnayaTech.") {
    Stack(class: "page") {
        PageHead("Experience", eyebrow: "Career", lead: "A reverse-chronological record of roles, responsibilities, and impact.")
        Stack(class: "timeline") {
            for role in roles by "{role.company}-{role.from}" {
                RoleEntry(role)
            }
        }
    }
}
