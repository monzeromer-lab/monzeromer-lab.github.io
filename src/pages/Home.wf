Page Home (path: "/", title: "Monzer Omer — Senior Backend Engineer") {

    Container {
        style {
            max-width: "800px"
            margin: "0 auto"
            padding: "120px 2rem"
            min-height: "100vh"
            display: "flex"
            flex-direction: "column"
            justify-content: "center"
        }

        Stack(gap: md) {
            Heading("Monzer Omer", h1) {
                style {
                    font-size: "3rem"
                    font-weight: "700"
                    color: "#E8E6E1"
                    letter-spacing: "-0.02em"
                    line-height: "1.1"
                }
            }

            Spacer(sm)

            Text("Senior Backend Engineer", muted) {
                style {
                    font-size: "1.25rem"
                    color: "#8C8B88"
                    font-weight: "400"
                }
            }

            Spacer(sm)

            Text("Architecting scalable, resilient solutions and high-performance systems. Dedicated to clean, maintainable server-side architectures, data integrity, and low-level optimization.") {
                style {
                    font-size: "1.1rem"
                    color: "#E8E6E1"
                    line-height: "1.7"
                    max-width: "600px"
                }
            }

            Spacer()

            Row(gap: md) {
                Badge("Rust", primary) {
                    style {
                        font-family: "JetBrains Mono, monospace"
                        background: "#C69C6D"
                        color: "#1A1A19"
                        padding: "0.4rem 1rem"
                        border-radius: "0.375rem"
                        font-size: "0.875rem"
                        font-weight: "600"
                    }
                }
                Badge("Node.js") {
                    style {
                        font-family: "JetBrains Mono, monospace"
                        background: "#2D2C2A"
                        color: "#E8E6E1"
                        padding: "0.4rem 1rem"
                        border-radius: "0.375rem"
                        font-size: "0.875rem"
                    }
                }
                Badge("Distributed Systems") {
                    style {
                        font-family: "JetBrains Mono, monospace"
                        background: "#2D2C2A"
                        color: "#E8E6E1"
                        padding: "0.4rem 1rem"
                        border-radius: "0.375rem"
                        font-size: "0.875rem"
                    }
                }
            }

            Spacer(xl)

            Row(gap: md) {
                Link(to: "/experience") {
                    Text("View Experience →") {
                        style {
                            color: "#C69C6D"
                            font-weight: "500"
                            font-size: "1rem"
                        }
                    }
                }
                Link(to: "/contact") {
                    Text("Get in Touch →") {
                        style {
                            color: "#8C8B88"
                            font-size: "1rem"
                        }
                    }
                }
            }
        }
    }
}
