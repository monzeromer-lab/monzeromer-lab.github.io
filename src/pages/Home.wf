/// The front page: who, the career as a trace, how I work, selected work,
/// where I am now, and how to reach me.
component HomeView(lang: Lang = .ar) {
    derived c = if lang == .ar { copyAr } else { copyEn }
    derived base = if lang == .ar { "" } else { "/en" }
    derived ps = if lang == .ar { projectsAr } else { projects }
    derived rs = if lang == .ar { rolesAr } else { roles }
    derived flagship = ps.filter(p => p.featured)
    derived selected = ps.filter(p => p.selected && !p.featured)
    derived current = rs.filter(r => r.current)

    Stack(class: "page home") {
        Stack(class: "hero") {
            Row { Status(c.status) }
            Stack(class: "hero-name") {
                Heading(c.name, class: "display").h1
                Text(c.role, class: "hero-role")
            }
            Text(c.lead, class: "lead")
            Row(class: "actions") {
                Link(c.cta1, to: "{base}/projects", class: "btn btn-primary", data-track: "select_content", data-track-content-type: "cta", data-track-item-id: "view_projects")
                Link(c.cta2, href: "mailto:{EMAIL}", class: "btn btn-secondary")
            }
        }

        Stack(class: "section") {
            Row(class: "section-head") {
                Heading(c.trace_h, class: "section-title").h2
            }
            Trace(lang: lang)
        }

        Row(class: "section split") {
            Stack(class: "split-head") {
                Heading(c.ai_h, class: "section-title").h2
            }
            Stack(class: "split-body") {
                AIMeter(lang: lang, large: true)
                Text(c.ai_p, class: "body muted")
            }
        }

        Stack(class: "section") {
            Row(class: "section-head") {
                Heading(c.work_h, class: "section-title").h2
                Link(c.work_all, to: "{base}/projects", class: "text-link")
            }
            for p in flagship by p.id {
                Flagship(p, lang: lang)
            }
            Stack(class: "index") {
                for p in selected by p.id {
                    ProjectRow(p, lang: lang)
                }
            }
        }

        Stack(class: "section") {
            Row(class: "section-head") {
                Heading(c.now_h, class: "section-title").h2
                Link(c.now_all, to: "{base}/experience", class: "text-link")
            }
            Row(class: "now-grid") {
                for r in current by r.company {
                    Stack(class: "now-card") {
                        Row(class: "now-card-top") {
                            Text("{r.from} – {r.to}", class: "num muted")
                            Status(c.current)
                        }
                        Stack(class: "entry-title") {
                            Heading(r.company, class: "entry-name").h3
                            Text(r.title, class: "entry-sub")
                        }
                        Text(if r.about != "" { r.about } else { r.points.first() ?? "" }, class: "body")
                        Chips(r.tags)
                    }
                }
            }
        }

        Row(class: "band") {
            Stack(class: "band-text") {
                Heading(c.band_h, class: "section-title").h2
                Text(c.band_p, class: "body muted")
                Link(EMAIL, href: "mailto:{EMAIL}", class: "band-email", dir: "ltr")
            }
            Row(class: "actions") {
                Link("LinkedIn", href: LINKEDIN, class: "btn btn-secondary", data-track: "generate_lead", data-track-method: "linkedin")
                Link("GitHub", href: GITHUB, class: "btn btn-secondary", data-track: "generate_lead", data-track-method: "github")
            }
        }
    }
}

page HomeAr(path: "/", title: "منذر عمر — Senior Backend Engineer",
            description: "منذر عمر، Senior Backend Engineer يعمل بـ Rust وNode.js والـ Distributed Systems. المشاريع والخبرات وطرق التواصل.",
            layout: Shell(lang: .ar, current: .home)) {
    head {
        link(rel: "alternate", hreflang: "ar", href: "{SITE}/")
        link(rel: "alternate", hreflang: "en", href: "{SITE}/en")
        link(rel: "alternate", hreflang: "x-default", href: "{SITE}/")
    }
    HomeView(lang: .ar)
}

page HomeEn(path: "/en", title: "Monzer Omer — Senior backend engineer",
            description: "Senior backend engineer specializing in Rust, Node.js and distributed systems. AI-augmented workflow.",
            layout: Shell(lang: .en, current: .home)) {
    head {
        link(rel: "alternate", hreflang: "ar", href: "{SITE}/")
        link(rel: "alternate", hreflang: "en", href: "{SITE}/en")
        link(rel: "alternate", hreflang: "x-default", href: "{SITE}/")
    }
    HomeView(lang: .en)
}
