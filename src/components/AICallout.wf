/// Why I work with AI, and what stays mine.
component AICallout(title: String = "I code with AI — intentionally") {
    Stack(class: "callout") {
        Text(title, class: "callout-title")
        Text("{AI_SHARE}% of my code is now written with AI assistance. I treat it as a force multiplier: I architect, review, and own the output — the AI accelerates execution. The results speak for themselves: a Rust image service that improved performance by 98%, a compiler built with WebFluent, and production systems running across MENA and Africa.", class: "body")
    }
}
