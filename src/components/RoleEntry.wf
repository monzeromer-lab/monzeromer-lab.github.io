/// One role, in full: the dates and the length beside it, then the work.
component RoleEntry(_ role: Role, lang: Lang = .ar) {
    derived c = if lang == .ar { copyAr } else { copyEn }

    Row(class: "entry") {
        Stack(class: "entry-when") {
            Text("{role.from} – {role.to}", class: "num")
            if role.length != "" {
                Text(role.length, class: "num subtle")
            }
            if role.current {
                Row { Status(c.current) }
            }
        }
        Stack(class: "entry-what") {
            Stack(class: "entry-title") {
                Heading(role.company, class: "entry-name").h2
                Text(role.title, class: "entry-sub")
            }
            if role.about != "" {
                Text(role.about, class: "body")
            }
            Points(role.points)
            Chips(role.tags)
        }
    }
}
