/// The footer: where else to find me, and what the site is made of.
component SiteFooter {
    Footer(class: "site-footer") {
        Row(class: "site-footer-inner") {
            Row(class: "links") {
                Link("GitHub", href: GITHUB)
                Link("LinkedIn", href: LINKEDIN)
                Link(EMAIL, href: "mailto:{EMAIL}")
                Button("Cookie settings", class: "link-btn") { on click { Consent.reopen() } }
            }
            Row(align: .center) {
                style { gap: 4px }
                Text("© 2026 Monzer Omer · Written in", class: "note")
                Link("WebFluent", href: WEBFLUENT)
            }
        }
    }
}
