/// How much of my workflow is AI-assisted, as a labelled meter.
component AIBadge {
    Row(class: "ai-badge", role: "img", aria-label: "AI-augmented workflow: {AI_SHARE}%") {
        Text("AI-augmented workflow", class: "ai-badge-label")
        Stack(class: "ai-meter") {
            Stack(class: "ai-meter-fill")
        }
        Text("{AI_SHARE}%", class: "ai-badge-value")
    }
}
