/// The top bar: the mark, the places to read, the other language and the
/// theme. On a phone the places fold behind a menu button.
component SiteHeader(lang: Lang = .ar, current: Place = .home) {
    state menu = false
    // Dark unless the reader chose light.
    derived dark = theme != "light"
    derived c = if lang == .ar { copyAr } else { copyEn }
    // Arabic lives at the root, English under /en.
    derived base = if lang == .ar { "" } else { "/en" }
    derived here = match current {
        .home { "" }
        .projects { "/projects" }
        .experience { "/experience" }
        .skills { "/skills" }
        .education { "/education" }
        .contact { "/contact" }
    }
    derived home = if lang == .ar { "/" } else { "/en" }
    derived other = if lang == .ar { "/en{here}" } else { if here == "" { "/" } else { here } }

    on key("Escape") { menu = false }

    Stack(role: "banner", class: "site-header") {
        Row(class: "site-header-inner") {
            Link(to: home, class: "brand", aria-label: c.home_label) {
                Image(src: "/mo-logo-on-dark.svg", alt: "", class: "logo logo-on-dark", width: 48, height: 26)
                Image(src: "/mo-logo.svg", alt: "", class: "logo logo-on-light", width: 48, height: 26)
                Text(c.name, class: "brand-name")
            }

            Row(role: "navigation", aria-label: c.nav_label, class: "nav") {
                Link(c.nav_projects, to: "{base}/projects")
                Link(c.nav_experience, to: "{base}/experience")
                Link(c.nav_skills, to: "{base}/skills")
                Link(c.nav_education, to: "{base}/education")
                Link(c.nav_contact, to: "{base}/contact")
            }

            Row(class: "header-actions") {
                // hreflang names the language the link leads to: an attribute, on purpose
                // wf-allow(C04)
                Link(c.other_lang, to: other, class: "lang-switch", lang: if lang == .ar { "en" } else { "ar" }, hreflang: if lang == .ar { "en" } else { "ar" }, data-track: "select_content", data-track-content-type: "language", data-track-item-id: if lang == .ar { "en" } else { "ar" })
                IconButton(icon: if dark { "sun" } else { "moon" }, label: if dark { c.theme_to_light } else { c.theme_to_dark }, class: "icon-btn", data-track: "select_content", data-track-content-type: "theme", data-track-item-id: if dark { "light" } else { "dark" }) {
                    on click { setTheme(if dark { "light" } else { "dark" }) }
                }
                IconButton(icon: if menu { "close" } else { "menu" }, label: c.menu, class: "icon-btn menu-btn", aria-expanded: menu) {
                    on click { menu = !menu }
                }
            }
        }
    }

    if menu {
        Stack(role: "navigation", aria-label: c.nav_label, class: "menu") {
            Link(c.name, to: home) { on click { menu = false } }
            Link(c.nav_projects, to: "{base}/projects") { on click { menu = false } }
            Link(c.nav_experience, to: "{base}/experience") { on click { menu = false } }
            Link(c.nav_skills, to: "{base}/skills") { on click { menu = false } }
            Link(c.nav_education, to: "{base}/education") { on click { menu = false } }
            Link(c.nav_contact, to: "{base}/contact") { on click { menu = false } }
        }
    }
}
