App {

    // Fixed sidebar navigation
    Container {
        style {
            position: "fixed"
            top: "0"
            left: "0"
            bottom: "0"
            width: "220px"
            max-width: "220px"
            z-index: "300"
            padding: "0"
            background: "#1A1A19"
            border-right: "1px solid #2D2C2A"
            overflow-y: "auto"
            display: "flex"
            flex-direction: "column"
        }

        // Brand
        Container {
            style {
                padding: "1.5rem"
                border-bottom: "1px solid #2D2C2A"
                max-width: "100%"
            }

            Stack(gap: sm) {
                Link(to: "/") {
                    Text("monzer.omer", bold) {
                        style {
                            font-family: "JetBrains Mono, monospace"
                            color: "#E8E6E1"
                            font-size: "1rem"
                            font-weight: "600"
                        }
                    }
                }
                Text("Senior Backend Engineer", muted) {
                    style {
                        color: "#8C8B88"
                        font-size: "0.75rem"
                    }
                }
            }
        }

        // Nav links
        Stack(gap: sm) {
            style {
                padding: "1rem 0"
            }

            Link(to: "/") {
                Row(gap: sm, align: center) {
                    style {
                        padding: "0.5rem 1.5rem"
                        color: "#8C8B88"
                        cursor: "pointer"
                    }
                    Icon("home") {
                        style {
                            width: "16px"
                            height: "16px"
                        }
                    }
                    Text("Home") {
                        style {
                            font-size: "0.875rem"
                        }
                    }
                }
            }

            Link(to: "/projects") {
                Row(gap: sm, align: center) {
                    style {
                        padding: "0.5rem 1.5rem"
                        color: "#8C8B88"
                        cursor: "pointer"
                    }
                    Icon("star") {
                        style {
                            width: "16px"
                            height: "16px"
                        }
                    }
                    Text("Projects") {
                        style {
                            font-size: "0.875rem"
                        }
                    }
                }
            }

            Link(to: "/experience") {
                Row(gap: sm, align: center) {
                    style {
                        padding: "0.5rem 1.5rem"
                        color: "#8C8B88"
                        cursor: "pointer"
                    }
                    Icon("calendar") {
                        style {
                            width: "16px"
                            height: "16px"
                        }
                    }
                    Text("Experience") {
                        style {
                            font-size: "0.875rem"
                        }
                    }
                }
            }

            Link(to: "/skills") {
                Row(gap: sm, align: center) {
                    style {
                        padding: "0.5rem 1.5rem"
                        color: "#8C8B88"
                        cursor: "pointer"
                    }
                    Icon("settings") {
                        style {
                            width: "16px"
                            height: "16px"
                        }
                    }
                    Text("Skills") {
                        style {
                            font-size: "0.875rem"
                        }
                    }
                }
            }

            Link(to: "/education") {
                Row(gap: sm, align: center) {
                    style {
                        padding: "0.5rem 1.5rem"
                        color: "#8C8B88"
                        cursor: "pointer"
                    }
                    Icon("info") {
                        style {
                            width: "16px"
                            height: "16px"
                        }
                    }
                    Text("Education") {
                        style {
                            font-size: "0.875rem"
                        }
                    }
                }
            }

            Link(to: "/contact") {
                Row(gap: sm, align: center) {
                    style {
                        padding: "0.5rem 1.5rem"
                        color: "#8C8B88"
                        cursor: "pointer"
                    }
                    Icon("mail") {
                        style {
                            width: "16px"
                            height: "16px"
                        }
                    }
                    Text("Contact") {
                        style {
                            font-size: "0.875rem"
                        }
                    }
                }
            }
        }

        // Bottom section — social + branding
        Stack(gap: sm) {
            style {
                padding: "1rem 1.5rem"
                margin-top: "auto"
                border-top: "1px solid #2D2C2A"
            }

            Row(gap: md) {
                Link(to: "https://github.com/monzeromer-lab") {
                    Text("GitHub") {
                        style {
                            font-family: "JetBrains Mono, monospace"
                            color: "#8C8B88"
                            font-size: "0.75rem"
                        }
                    }
                }
                Link(to: "https://www.linkedin.com/in/monzeromer/") {
                    Text("LinkedIn") {
                        style {
                            font-family: "JetBrains Mono, monospace"
                            color: "#8C8B88"
                            font-size: "0.75rem"
                        }
                    }
                }
            }

            Text("Built with WebFluent", muted) {
                style {
                    font-family: "JetBrains Mono, monospace"
                    color: "#555"
                    font-size: "0.7rem"
                    margin-top: "0.5rem"
                }
            }
        }
    }

    // Main content area
    Container {
        style {
            margin-left: "220px"
            max-width: "100%"
            min-height: "100vh"
            padding: "0"
        }

        Router {
            Route(path: "/", page: Home)
            Route(path: "/projects", page: Projects)
            Route(path: "/experience", page: Experience)
            Route(path: "/skills", page: Skills)
            Route(path: "/education", page: Education)
            Route(path: "/contact", page: Contact)
        }
    }
}
