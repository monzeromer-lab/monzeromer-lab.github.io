/// MO Systems, dark — the site's theme. Two inks drawn from one mark:
/// graphite is structure, blue is intent, cyan is data, and nothing else
/// carries colour. Dark lifts by stepping the surface lighter, not by
/// shadow. The light palette, for a reader who asks for it, is in
/// `theme-light.css`.
theme MoDark {
    color-primary: #3D6FA3
    color-secondary: #2F9FB6
    color-success: #2F9D76
    color-danger: #D94F45
    color-warning: #C98A1F
    color-info: #3D6FA3

    color-background: #0E1012
    color-surface: #17191C
    color-text: #EEF0F2
    color-text-muted: #A9AEB4
    color-border: #2C3035

    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif
    font-family-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace

    radius-none: 0
    radius-sm: 4px
    radius-md: 6px
    radius-lg: 10px
    radius-xl: 16px
    radius-full: 999px

    shadow-sm: 0 1px 2px rgba(0,0,0,0.55), 0 2px 6px rgba(0,0,0,0.4)
    shadow-md: 0 2px 4px rgba(0,0,0,0.5), 0 8px 20px rgba(0,0,0,0.5)
    shadow-lg: 0 4px 8px rgba(0,0,0,0.5), 0 16px 40px rgba(0,0,0,0.6)

    transition-fast: 100ms ease
    transition-normal: 140ms ease

    // Surfaces, layered canvas -> surface -> raised -> overlay.
    surface-canvas: #0E1012
    surface-raised: #1F2225
    surface-sunken: #0E1012
    surface-overlay: #24282C
    surface-hover: #1F2225

    // Ink beyond the two baseline steps.
    ink-subtle: #878D93
    ink-inverse: #17191C

    // Brand and accent, past the primary fill.
    brand-hover: #33689C
    brand-ink: #8FBDE7
    brand-subtle: #16283C
    brand-ring: #8FBDE7
    accent: #2F9FB6
    accent-ink: #6FD3E6
    accent-subtle: #10313A

    border-strong: #6B7178
    border-brand: #6A9BCB

    // A console stays dark in both themes.
    term-bg: #101315
    term-ink: #E6E9EC
    term-dim: #959BA1
    syntax-keyword: #8FBDE7
    syntax-string: #7FD6A8
    syntax-number: #E0B070
    syntax-function: #6FD3E6
    syntax-punct: #B3BAC0
    syntax-comment: #959BA1

    // Measures.
    prose-max: 680px
    content-max: 1120px
}
