      },
      "knowsAbout": [
        "Rust",
        "Node.js",
        "TypeScript",
        "Distributed systems",
        "Microservices",
        "Apache Kafka",
        "GraphQL",
        "Compiler design",
        "WebAssembly"
      ],
      "knowsLanguage": [
        "ar",
        "en"
      ]
    },
    "sitemap": true,
    "preload": [
      "/fonts/inter-latin.woff2",
      "/fonts/jetbrains-mono-latin.woff2"
    ],
    "scripts": [
      {
        "src": "https://www.googletagmanager.com/gtag/js?id=G-NJ43DW0SFV",
