{
  "name": "Monzer Omer — Portfolio",
  "version": "2.0.0",
  "author": "Monzer Omer",
  "theme": {
    "name": "MoDark"
  },
  "build": {
    "output": "./build",
    "minify": true,
    "ssg": true,
    "split": false,
    "compress": false,
    "csp": true,
    "clean_urls": "file"
  },
  "dev": {
    "port": 3000,
    "hot_reload": true
  },
  "motion": {
    "duration": "120ms",
    "easing": "$ease-standard"
